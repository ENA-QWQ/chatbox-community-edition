# Electron compatibility - use flat node_modules
node-linker=hoisted

# Auto-install peer dependencies
auto-install-peers=true

# [Chatbox CE] explicit registry: .erb/scripts/ensure-app-deps.cjs (electron-builder
# beforePack hook) requires a project-level registry for the release/app npm ci.
# Developers who prefer a mirror can override it in their user-level .npmrc.
registry=https://registry.npmjs.org/

# Preserved from original npm config
node-options=--max-old-space-size=5120
update-notifier=false
engine-strict=true
